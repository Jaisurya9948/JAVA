package com.JaiSurya.Practice;

import java.util.Iterator;

public class Strings {

	public static void main(String[] args) {
		String s1 = "swiss";
		String repeated = "";
		char nonrepeated = s1.charAt(0);
		for (int i = 0; i < s1.length(); i++) {
			boolean res1 = false;
			for (int j = 0; j < i ; j++) {
				if(s1.charAt(i) == s1.charAt(j)) {
					repeated +=s1.charAt(j);
					res1 = true;
				}
			}
			if(res1) break;
		}
		for (int i = 0; i < s1.length(); i++) {
		    boolean repeatedChar = false;

		    for (int j = 0; j < s1.length(); j++) {
		        if (i != j && s1.charAt(i) == s1.charAt(j)) {
		            repeatedChar = true;
		            break;
		        }
		    }

		    if (!repeatedChar) {
		        nonrepeated = s1.charAt(i);
		        break;
		    }
		}
		
		System.out.println(repeated);
		System.out.println(nonrepeated);
	}
}
